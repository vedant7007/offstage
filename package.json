{
  "name": "offstage",
  "version": "1.0.0",
  "private": true,
  "description": "AI event operations team in a box. 14 agents, one human lead each.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "event-management",
    "nextjs",
    "typescript",
    "postgresql",
    "pgvector",
    "llm",
    "rag"
  ],
  "homepage": "https://offstage-live.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedant7007/offstage.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch worker/index.ts",
    "worker:prod": "tsx worker/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:showcase-net": "playwright test --config playwright.showcase.config.ts showcase-network",
    "test:showcase-qa": "playwright test --config playwright.showcase.config.ts showcase-qa",
    "contrast": "node src/styles/check-contrast.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/run.ts",
    "demo:reset": "tsx src/db/demo/reset.ts",
    "demo:trigger": "tsx src/db/demo/trigger.ts",
    "demo:preflight": "tsx scripts/demo-preflight.ts",
    "keys": "tsx scripts/gen-keys.ts",
    "ses:smtp-password": "tsx scripts/ses-smtp-password.ts",
    "ai:smoke": "tsx src/ai/smoke.ts",
    "ai:models": "tsx src/ai/rag/prefetch.ts",
    "kb:index": "tsx src/ai/rag/index-cli.ts",
    "evals": "tsx tests/evals/run.ts",
    "voice:audio": "tsx tests/voice/make-audio.ts",
    "voice:test": "tsx tests/voice/run.ts",
    "db:counts": "tsx src/db/counts.ts",
    "showcase:fixtures": "tsx scripts/export-showcase-fixtures.ts",
    "test:db": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.102",
    "@ai-sdk/groq": "4.0.53",
    "@faker-js/faker": "10.6.0",
    "@huggingface/transformers": "4.3.0",
    "@xyflow/react": "12.12.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "ai": "7.0.123",
    "ai-sdk-ollama": "4.3.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "^1.48.0",
    "maath": "0.10.8",
    "next": "16.3.7",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.13",
    "pg-boss": "12.35.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "postprocessing": "6.39.5",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "2.0.8",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
