# Sutradhar environment. Copy to .env and fill in. Never commit .env.
# Generate AUTH_SECRET, ticket keys and PII key with: pnpm keys

# ---------- Core ----------
# Postgres connection. Matches the db service in docker-compose.yml.
DATABASE_URL=postgres://sutradhar:sutradhar@localhost:5432/sutradhar
# Optional: max pooled connections per process (default 10).
DATABASE_POOL_MAX=10
# Role the app and worker run as. It cannot alter the schema or rewrite audit_log and domain_events.
# Migrations and demo:reset still connect as the owner in DATABASE_URL. Leave empty to run as the owner.
DATABASE_APP_ROLE=sutradhar_app
# Public base URL of the web app, used in links inside emails and QR codes.
APP_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true enables the persona switcher (POST /api/demo/switch-persona) and demo triggers. Never true for real events.
DEMO_MODE=true
# 1 makes src/lib/api-client.ts answer from the contract fixtures, with no backend. Leave empty normally.
NEXT_PUBLIC_API_MOCK=

# ---------- Secrets (pnpm keys) ----------
# Session and CSRF signing secret for Better Auth. 32 random bytes, base64url.
AUTH_SECRET=
# Ed25519 key pair for signing ticket QR codes. Base64 of DER (PKCS8 private, SPKI public).
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_PUBLIC_KEY=
# AES-256-GCM key for encrypting attendee email and phone at rest. 32 random bytes, base64.
PII_ENCRYPTION_KEY=

# ---------- Email ----------
# mailpit (local web inbox at http://localhost:8025) | ses | resend | mock (logs only, writes outbox)
EMAIL_DRIVER=mailpit
# From address for all outgoing mail. SES requires a verified identity.
EMAIL_FROM="Sutradhar <no-reply@sutradhar.local>"
# SMTP settings, used by the mailpit driver (and any plain SMTP relay).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Resend API key, only when EMAIL_DRIVER=resend.
RESEND_API_KEY=

# ---------- AWS (SES email, Bedrock models, S3 backups) ----------
# Region where SES identities and Bedrock Nova access are enabled, for example ap-south-1.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Telegram ----------
# Bot token from BotFather. Leave empty to use the mock driver.
TELEGRAM_BOT_TOKEN=
# Bot username without the @, for the "open the bot" link and the /start deep link.
TELEGRAM_BOT_USERNAME=
# "on" only in the one worker that owns the bot (the server). Telegram allows one poller per token;
# a second one makes both fail with 409. Sending works either way.
TELEGRAM_POLLING=off

# ---------- Twilio (WhatsApp sandbox, SMS trial) ----------
# Account SID and auth token from the Twilio console. Leave empty to use the mock driver.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sandbox sender, format whatsapp:+14155238886 (check your console for the exact number).
TWILIO_WHATSAPP_FROM=
# SMS sender number bought on the trial account, E.164. Trial sends only to verified numbers.
TWILIO_SMS_FROM=
# The join phrase for the WhatsApp sandbox ("join <two words>"), shown to people who need to opt in.
WHATSAPP_SANDBOX_JOIN=

# ---------- Real delivery allowlist ----------
# Comma-separated E.164 numbers, emails and Telegram chat ids that may receive REAL messages.
# Everyone else goes through the mock driver and is marked delivered_mock in the outbox.
# Telegram chat ids of people who sent /start to the bot and are matched to an allowlisted user count too.
DEMO_REAL_RECIPIENTS=
# "on" to really send to DEMO_REAL_RECIPIENTS. "off" (the default) marks every message delivered
# to the mock driver, to save provider caps (Twilio trial: 50 a day). The console can flip it.
REAL_SENDS=off

# ---------- AI (owned by Vedant, see docs/decisions/ADR-001-model-access.md) ----------
# dev: Ollama first, Groq free tier second. demo: Bedrock and Groq first.
AI_PROFILE=dev
# Groq API key for gpt-oss, Prompt Guard and Whisper.
GROQ_API_KEY=
# Ollama server on the GPU laptop.
OLLAMA_BASE_URL=http://localhost:11434
# Optional AI settings (defaults shown). See docs/decisions/ADR-003-ai-stack-versions.md.
# Local model; qwen3:4b-instruct is the largest Qwen3 that stays fully on a 6 GB GPU at 8k context.
# OLLAMA_MODEL=qwen3:4b-instruct
# Bedrock model or inference profile. From ap-south-1 only the global profile reaches Nova 2 Lite.
# BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
# Bedrock API key, an alternative to the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY pair above.
# AWS_BEARER_TOKEN_BEDROCK=
# Override a tier's provider order, comma separated from groq, bedrock, ollama.
# AI_CHAIN_SMART=bedrock,groq,ollama
# AI_CHAIN_FAST=groq,bedrock,ollama
# Groq limits per model (free tier values). Raise after the paid upgrade.
# GROQ_RPM=30
# GROQ_TPM=8000
# GROQ_TPD=200000
# Spend guards: tokens per agent run, USD per IST day, concurrent runs per agent.
# AI_RUN_TOKEN_BUDGET=30000
# AI_DAILY_CAP_USD=3
# AI_AGENT_CONCURRENCY=2

# ---------- Cloudflare Turnstile (bot check on public register and OTP) ----------
# Leave both empty in local dev: verification is skipped with a warning log.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Cloud deploy only (docker compose --profile cloud) ----------
# Hostname Caddy serves and obtains an HTTPS certificate for.
DOMAIN=localhost
# true behind Caddy: trust X-Forwarded-For for client IPs (rate limits). Never true when the app is exposed directly.
TRUST_PROXY=false
# Postgres credentials used by the db container. Change these in the cloud.
POSTGRES_USER=sutradhar
POSTGRES_PASSWORD=sutradhar
POSTGRES_DB=sutradhar
