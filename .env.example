# OFFSTAGE environment for the full stack. Copy to .env and fill in. Never commit .env.
# The hosted showcase (NEXT_PUBLIC_SHOWCASE=1) needs none of these.
# Generate AUTH_SECRET, the ticket keys and PII_ENCRYPTION_KEY with: pnpm keys
# Values left here are non-secret local defaults. Optional settings are commented out with their default.

# ---------- Core ----------
# Postgres connection string (required). For the db service in docker-compose.yml use
# postgres://sutradhar:sutradhar@localhost:5432/sutradhar
DATABASE_URL=
# Max pooled connections per process.
DATABASE_POOL_MAX=10
# Role the app and worker run as. It cannot alter the schema or rewrite audit_log and domain_events.
# Migrations and demo:reset still connect as the owner in DATABASE_URL. Leave empty to run as the owner.
DATABASE_APP_ROLE=sutradhar_app
# Public base URL of the web app, used in links inside emails and QR codes.
APP_URL=http://localhost:3000
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true enables the persona switcher (POST /api/demo/switch-persona) and demo triggers. Never true for a real event.
DEMO_MODE=true
# 1 makes src/lib/api-client.ts answer from the contract fixtures, with no backend. Leave empty normally.
NEXT_PUBLIC_API_MOCK=
# 1 builds the zero-cost showcase: every screen replays recorded fixtures in the browser. Leave empty for the full stack.
NEXT_PUBLIC_SHOWCASE=

# ---------- Secrets (pnpm keys) ----------
# Session and CSRF signing secret for Better Auth. 32 random bytes, base64url.
AUTH_SECRET=
# Ed25519 private key that signs ticket QR codes. Base64 of PKCS8 DER.
TICKET_SIGNING_PRIVATE_KEY=
# Ed25519 public key that verifies ticket QR codes, also offline on crew phones. Base64 of SPKI DER.
TICKET_SIGNING_PUBLIC_KEY=
# AES-256-GCM key for encrypting attendee email and phone at rest. 32 random bytes, base64.
PII_ENCRYPTION_KEY=

# ---------- Email ----------
# Email driver: mailpit (local web inbox at http://localhost:8025) | ses | resend | mock (logs only, writes outbox)
EMAIL_DRIVER=mailpit
# From address for all outgoing mail. SES requires a verified identity.
# EMAIL_FROM="Sutradhar <no-reply@sutradhar.local>"
# SMTP host, used by the mailpit driver and any plain SMTP relay.
SMTP_HOST=localhost
# SMTP port. 1025 is Mailpit.
SMTP_PORT=1025
# SMTP user name, empty for Mailpit.
SMTP_USER=
# SMTP password, empty for Mailpit.
SMTP_PASS=
# true for implicit TLS (port 465).
SMTP_SECURE=false
# Resend API key, only when EMAIL_DRIVER=resend.
RESEND_API_KEY=
# Mailpit web API used by the demo inbox and pnpm demo:preflight.
# MAILPIT_URL=http://localhost:8025

# ---------- AWS (SES email, Bedrock models) ----------
# Region where SES identities and Bedrock Nova access are enabled, for example ap-south-1.
AWS_REGION=
# Access key id of an IAM user allowed to call SES and Bedrock.
AWS_ACCESS_KEY_ID=
# Secret access key for AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=

# ---------- Telegram ----------
# Bot token from BotFather. Leave empty to use the mock driver.
TELEGRAM_BOT_TOKEN=
# "on" only in the one worker that owns the bot. Telegram allows one poller per token;
# a second one makes both fail with 409. Sending works either way.
TELEGRAM_POLLING=off

# ---------- Twilio (WhatsApp sandbox, SMS) ----------
# Account SID from the Twilio console. Leave empty to use the mock driver.
TWILIO_ACCOUNT_SID=
# Auth token from the Twilio console. Also verifies inbound webhook signatures.
TWILIO_AUTH_TOKEN=
# WhatsApp sender, format whatsapp:+<number> (the sandbox number from your console).
TWILIO_WHATSAPP_FROM=
# SMS sender number, E.164. Trial accounts send only to verified numbers.
TWILIO_SMS_FROM=

# ---------- Real delivery allowlist ----------
# Comma-separated E.164 numbers, emails and Telegram chat ids that may receive REAL messages.
# Everyone else goes through the mock driver and is marked delivered_mock in the outbox.
DEMO_REAL_RECIPIENTS=
# "on" to really send to DEMO_REAL_RECIPIENTS. "off" marks every message delivered to the mock driver.
# The console can flip it at runtime.
REAL_SENDS=off

# ---------- AI (see docs/decisions/ADR-001-model-access.md) ----------
# Provider order: dev = Ollama first, then Groq. demo = Bedrock and Groq first.
AI_PROFILE=dev
# Groq API key for gpt-oss, Prompt Guard and Whisper.
GROQ_API_KEY=
# Murf API key for streaming text to speech in the voice Commander (server side only).
MURF_API_KEY=
# Ollama server URL.
OLLAMA_BASE_URL=http://localhost:11434
# Local Ollama model.
# OLLAMA_MODEL=qwen3:4b-instruct
# Bedrock model or inference profile.
# BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
# Bedrock API key, an alternative to the AWS access key pair above.
# AWS_BEARER_TOKEN_BEDROCK=
# Provider order for the smart tier, comma separated from groq, bedrock, ollama.
# AI_CHAIN_SMART=bedrock,groq,ollama
# Provider order for the fast tier.
# AI_CHAIN_FAST=groq,bedrock,ollama
# Groq requests per minute per model.
# GROQ_RPM=30
# Groq tokens per minute per model.
# GROQ_TPM=8000
# Groq tokens per day per model.
# GROQ_TPD=200000
# Token budget for one agent run.
# AI_RUN_TOKEN_BUDGET=30000
# Model spend cap in USD per IST day.
# AI_DAILY_CAP_USD=3
# Concurrent runs per agent.
# AI_AGENT_CONCURRENCY=2

# ---------- Cloudflare Turnstile (bot check on public register and OTP) ----------
# Site key, public. Leave both empty in local dev: verification is skipped with a warning log.
TURNSTILE_SITE_KEY=
# Secret key, server side only.
TURNSTILE_SECRET_KEY=

# ---------- Self-hosted deploy only (docker compose --profile cloud) ----------
# Hostname Caddy serves and obtains an HTTPS certificate for.
DOMAIN=localhost
# true behind Caddy: trust X-Forwarded-For for client IPs (rate limits). Never true when the app is exposed directly.
TRUST_PROXY=false
# Postgres user for the db container. Empty uses the compose default.
POSTGRES_USER=
# Postgres password for the db container. Set a strong one on any shared host.
POSTGRES_PASSWORD=
# Postgres database name for the db container. Empty uses the compose default.
POSTGRES_DB=
# Commit SHA reported by /api/health. Set by the deploy script.
# GIT_COMMIT=
