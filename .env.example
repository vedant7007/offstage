# Sutradhar environment. Copy to .env and fill in. Never commit .env.
# Generate AUTH_SECRET, ticket keys and PII key with: pnpm keys

# ---------- Core ----------
# Postgres connection. Matches the db service in docker-compose.yml.
DATABASE_URL=postgres://sutradhar:sutradhar@localhost:5432/sutradhar
# Optional: max pooled connections per process (default 10).
DATABASE_POOL_MAX=10
# Public base URL of the web app, used in links inside emails and QR codes.
APP_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# true enables the persona switcher (POST /api/demo/switch-persona) and demo triggers. Never true for real events.
DEMO_MODE=true

# ---------- Secrets (pnpm keys) ----------
# Session and CSRF signing secret for Better Auth. 32 random bytes, base64url.
AUTH_SECRET=
# Ed25519 key pair for signing ticket QR codes. Base64 of DER (PKCS8 private, SPKI public).
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_PUBLIC_KEY=
# AES-256-GCM key for encrypting attendee email and phone at rest. 32 random bytes, base64.
PII_ENCRYPTION_KEY=

# ---------- Email ----------
# mailpit (local web inbox at http://localhost:8025) | ses | resend | mock (logs only, writes outbox)
EMAIL_DRIVER=mailpit
# From address for all outgoing mail. SES requires a verified identity.
EMAIL_FROM="Sutradhar <no-reply@sutradhar.local>"
# SMTP settings, used by the mailpit driver (and any plain SMTP relay).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Resend API key, only when EMAIL_DRIVER=resend.
RESEND_API_KEY=

# ---------- AWS (SES email, Bedrock models, S3 backups) ----------
# Region where SES identities and Bedrock Nova access are enabled, for example ap-south-1.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Telegram ----------
# Bot token from BotFather. Leave empty to use the mock driver.
TELEGRAM_BOT_TOKEN=

# ---------- Twilio (WhatsApp sandbox, SMS trial) ----------
# Account SID and auth token from the Twilio console. Leave empty to use the mock driver.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sandbox sender, format whatsapp:+14155238886 (check your console for the exact number).
TWILIO_WHATSAPP_FROM=
# SMS sender number bought on the trial account, E.164. Trial sends only to verified numbers.
TWILIO_SMS_FROM=

# ---------- AI (owned by Vedant, see docs/decisions/ADR-001-model-access.md) ----------
# dev: Ollama first, Groq free tier second. demo: Bedrock and Groq first.
AI_PROFILE=dev
# Groq API key for gpt-oss, Prompt Guard and Whisper.
GROQ_API_KEY=
# Ollama server on the GPU laptop.
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Cloudflare Turnstile (bot check on public register and OTP) ----------
# Leave both empty in local dev: verification is skipped with a warning log.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Cloud deploy only (docker compose --profile cloud) ----------
# Hostname Caddy serves and obtains an HTTPS certificate for.
DOMAIN=localhost
# Postgres credentials used by the db container. Change these in the cloud.
POSTGRES_USER=sutradhar
POSTGRES_PASSWORD=sutradhar
POSTGRES_DB=sutradhar
